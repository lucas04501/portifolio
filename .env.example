# Copie para .env.local (nunca versionar .env.local).
#
# Opcional. Token do GitHub só para elevar o limite de requisições da API.
# Sem ele o site funciona normalmente (60 requisições/hora, com cache de 1h).
# Se usar, crie um token com o MENOR escopo possível (apenas leitura de dados públicos).
GITHUB_TOKEN=

# Opcional. URL publica do site (canonical, Open Graph, sitemap). Sem ela vale o endereco atual na Vercel.
NEXT_PUBLIC_SITE_URL=
